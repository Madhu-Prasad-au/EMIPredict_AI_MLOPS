emi_prediction_dataset.csv
data/emi_prediction_cleaned.csv
data/financial_records.csv

# ---------------------------------------------------------------------------
# Model artifacts
# ---------------------------------------------------------------------------
# The 1.1 GB uncompressed artifact and the 295 MB compressed artifact are not
# committed. The Docker build copies the compressed file when present locally
# and otherwise downloads it from Hugging Face with a SHA-256 check.
models/best_regression_model.pkl
models/best_regression_model_compressed.pkl
models/*.part

# Small, required artifacts that SHOULD be committed:
#   models/best_classification_model.pkl
#   models/classification_label_encoder.pkl
#   models/feature_info.pkl
#   models/preprocessing_stats.json

# ---------------------------------------------------------------------------
# MLflow / experiment tracking
# ---------------------------------------------------------------------------
mlruns/
mlartifacts/
mlflow.db

